{
  "schema_version": "2026-04-28.v1",
  "description": "Follow-up context boundaries where a new question should not inherit stale transaction filters.",
  "cases": [
    {
      "name": "china_transaction_then_russian_counterparty_nexus_does_not_inherit_china",
      "description": "A new counterparty/nexus question containing the word 'that' should not inherit China transaction filters from the prior turn.",
      "tenant_id": 1,
      "create_session": true,
      "turns": [
        {
          "question": "I am looking for transactions from China",
          "expect": {
            "scope": "global",
            "queried_steps": ["transaction_filter_mapping", "global_transaction_details"],
            "must_not_query_steps": ["seed_search", "graph_expansion", "transaction_details"],
            "plan_endpoints": ["/api/graph/exposure/transactions/global"],
            "filters": {
              "direction": "Inbound",
              "counterparty_jurisdiction": "CN",
              "outside_counterparty_jurisdiction": null
            }
          }
        },
        {
          "question": "show me counterparties that have a Russian nexus",
          "expect": {
            "scope": "global",
            "queried_steps": ["transaction_filter_mapping", "global_transaction_details"],
            "must_not_query_steps": ["seed_search", "graph_expansion", "transaction_details"],
            "plan_endpoints": ["/api/graph/exposure/transactions/global"],
            "filters": {
              "direction": null,
              "counterparty_jurisdiction": "RU",
              "outside_counterparty_jurisdiction": null,
              "outside_country_code_2": null
            },
            "min_tx_rows": 1
          }
        },
        {
          "question": "is there any negative news linked to those counterparties",
          "include_graph": true,
          "expect": {
            "scope": "global",
            "queried_steps": [
              "transaction_filter_mapping",
              "global_transaction_details",
              "transaction_node_graph_enrichment"
            ],
            "must_not_query_steps": ["seed_search", "graph_expansion", "transaction_details"],
            "plan_endpoints": ["/api/graph/exposure/transactions/global"],
            "filters": {
              "counterparty_jurisdiction": "RU",
              "outside_counterparty_jurisdiction": null,
              "outside_country_code_2": null
            },
            "min_tx_rows": 1,
            "min_enriched_transaction_nodes": 1,
            "min_graph_nodes": 1
          }
        }
      ]
    }
  ]
}
